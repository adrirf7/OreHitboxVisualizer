<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>OreHitboxVisualizer</AssemblyName>
    <RootNamespace>OreHitboxVisualizer</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <!-- Ruta de instalación de Valheim. Se puede cambiar con: dotnet build -p:ValheimDir="D:\...\Valheim" -->
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <ManagedDir>$(ValheimDir)\valheim_Data\Managed</ManagedDir>
    <BepInExDir>$(ValheimDir)\BepInEx</BepInExDir>
    <!-- Copiar automáticamente el .dll a BepInEx\plugins al compilar -->
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="assembly_valheim" Publicize="true">
      <HintPath>$(ManagedDir)\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ManagedDir)\assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_guiutils" Publicize="true">
      <HintPath>$(ManagedDir)\assembly_guiutils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Debug   (dotnet build): copia el .dll a BepInEx\scripts. ScriptEngine lo recarga solo con el juego abierto (o con F7).
    Release (dotnet build -c Release): copia el .dll a BepInEx\plugins, como lo instala un jugador.
    Cada modo borra la copia del otro para que el mod no se cargue dos veces. Al cambiar de modo hay que reiniciar el juego una vez.
  -->
  <Target Name="DeployToValheim" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <PropertyGroup>
      <ScriptsDll>$(BepInExDir)\scripts\$(TargetFileName)</ScriptsDll>
      <ScriptsPdb>$(BepInExDir)\scripts\$(TargetName).pdb</ScriptsPdb>
      <PluginsDll>$(BepInExDir)\plugins\OreHitboxVisualizer\$(TargetFileName)</PluginsDll>
    </PropertyGroup>

    <!-- ScriptEngine lee siempre los símbolos (ReadSymbols = true): sin el .pdb al lado del .dll no carga el mod. -->
    <MakeDir Directories="$(BepInExDir)\scripts" Condition="'$(Configuration)' == 'Debug'" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(BepInExDir)\scripts" Condition="'$(Configuration)' == 'Debug'" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\scripts" Condition="'$(Configuration)' == 'Debug'" />
    <Delete Files="$(PluginsDll)" Condition="'$(Configuration)' == 'Debug'" ContinueOnError="true" />
    <Message Importance="high" Text="OreHitboxVisualizer copiado a $(BepInExDir)\scripts (recarga en caliente con ScriptEngine)" Condition="'$(Configuration)' == 'Debug'" />

    <MakeDir Directories="$(BepInExDir)\plugins\OreHitboxVisualizer" Condition="'$(Configuration)' != 'Debug'" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins\OreHitboxVisualizer" Condition="'$(Configuration)' != 'Debug'" />
    <Delete Files="$(ScriptsDll);$(ScriptsPdb)" Condition="'$(Configuration)' != 'Debug'" ContinueOnError="true" />
    <Message Importance="high" Text="OreHitboxVisualizer copiado a $(BepInExDir)\plugins\OreHitboxVisualizer" Condition="'$(Configuration)' != 'Debug'" />
  </Target>

  <!-- En Release, crea en release\ el zip para Nexus Mods y el de Thunderstore -->
  <Target Name="PackageRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PackageName>OreHitboxVisualizer</PackageName>
      <PackageDir>$(MSBuildProjectDirectory)\obj\package</PackageDir>
      <ReleaseDir>$(MSBuildProjectDirectory)\release</ReleaseDir>
    </PropertyGroup>
    <RemoveDir Directories="$(PackageDir)" />
    <MakeDir Directories="$(ReleaseDir)" />

    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageDir)\nexus\BepInEx\plugins\OreHitboxVisualizer" />
    <ZipDirectory SourceDirectory="$(PackageDir)\nexus" DestinationFile="$(ReleaseDir)\$(PackageName)-$(Version)-nexus.zip" Overwrite="true" />

    <Copy SourceFiles="$(TargetPath);thunderstore\manifest.json;thunderstore\README.md;thunderstore\icon.png" DestinationFolder="$(PackageDir)\thunderstore" />
    <ZipDirectory SourceDirectory="$(PackageDir)\thunderstore" DestinationFile="$(ReleaseDir)\$(PackageName)-$(Version)-thunderstore.zip" Overwrite="true" />

    <Message Importance="high" Text="Paquetes de Nexus y Thunderstore creados en $(ReleaseDir)" />
  </Target>

</Project>
